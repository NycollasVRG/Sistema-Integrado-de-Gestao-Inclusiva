# ==============================================================================
# SIGI / CLAI — Variáveis de Ambiente (Docker Compose & Spring Boot)
# Copie este arquivo para ".env" na raiz do projeto antes de subir os containers:
#   Linux/macOS: cp .env.example .env
#   Windows (PowerShell): Copy-Item .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. Perfil de Execução da Aplicação (Spring Boot Profile)
# ------------------------------------------------------------------------------
# Opções: "dev" (desenvolvimento) ou "prd" (produção)
# - dev: ativa logs detalhados, formatação SQL e permite fallbacks locais
# - prd: modo estrito; exige todas as credenciais/segredos e desativa logs de SQL
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# 1. Banco de Dados (PostgreSQL 16)
# ------------------------------------------------------------------------------
# OBRIGATÓRIO EM PRODUÇÃO (sem valores padrão aceitos no profile prd)
POSTGRES_DB=sigi_clai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_SCHEMA=sigi

# Porta exposta no Host (utilizada apenas em DEV; no compose de PRD a porta é isolada na rede interna)
DB_PORT=5432

# ------------------------------------------------------------------------------
# 2. Backend (Java 21 / Spring Boot)
# ------------------------------------------------------------------------------
# Porta da API no Host (utilizada em DEV; em PRD o acesso é roteado pelo proxy reverso Nginx)
BACKEND_PORT=8080

# Segredos de Segurança e Criptografia (Sprint 2 / US 11)
# CRÍTICO EM PRODUÇÃO:
# No perfil "prd", a aplicação falhará imediatamente se JWT_SECRET ou AES_KEY
# estiverem ausentes. Nunca utilize as chaves padrão abaixo em ambiente produtivo!
#
# Para gerar chaves criptograficamente seguras em produção:
#   JWT_SECRET (mínimo 256 bits): openssl rand -base64 48
#   AES_KEY (32 caracteres / 256 bits): openssl rand -hex 16
JWT_SECRET=sigi-clai-dev-jwt-secret-key-2026-ifpb-change-in-prod
AES_KEY=0123456789abcdef0123456789abcdef

# Tempo de expiração do token JWT em milissegundos (padrão: 8 horas = 28800000)
JWT_EXPIRATION_MS=28800000

# Caminho interno no container Backend onde o volume de anexos criptografados é montado (US 11)
ATTACHMENTS_STORAGE_PATH=/app/storage/anexos

# ------------------------------------------------------------------------------
# 3. Frontend (React 19 / Vite / Nginx)
# ------------------------------------------------------------------------------
# Porta HTTP exposta no Host (DEV: 5173; PRD: normalmente 80 ou mapeada para proxy externo)
FRONTEND_PORT=5173

# URL base da API injetada no build do Frontend (padrão "/api" usa o proxy reverso do Nginx)
VITE_API_URL=/api
VITE_USE_LOCAL_FALLBACK=false

# URL interna do Backend usada pelo proxy reverso do Nginx dentro da rede sigi-network
BACKEND_INTERNAL_URL=http://backend:8080
