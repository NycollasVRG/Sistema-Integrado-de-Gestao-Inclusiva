# ==============================================================================
# SIGI / CLAI — Variáveis de Ambiente (Docker Compose)
# Copie este arquivo para ".env" na raiz do projeto antes de subir os containers:
#   Linux/macOS: cp .env.example .env
#   Windows (PowerShell): Copy-Item .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Banco de Dados (PostgreSQL 14+)
# ------------------------------------------------------------------------------
POSTGRES_DB=sigi_clai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_SCHEMA=sigi
DB_PORT=5432

# ------------------------------------------------------------------------------
# 2. Backend (Java 21 / Spring Boot)
# ------------------------------------------------------------------------------
BACKEND_PORT=8080

# Segredos de Segurança e Criptografia (Sprint 2 / US 11)
# IMPORTANTE: Em produção/homologação, substitua por chaves fortes geradas aleatoriamente.
# JWT_SECRET: Chave HMAC-SHA256 (mínimo recomendado: 32 caracteres / 256 bits)
JWT_SECRET=sigi-clai-dev-jwt-secret-key-2026-ifpb-change-in-prod
# AES_KEY: Chave simétrica de 32 caracteres (256 bits) para criptografia de anexos sensíveis (US 11)
AES_KEY=0123456789abcdef0123456789abcdef

# Caminho interno no container Backend onde o volume de anexos criptografados é montado (US 11)
ATTACHMENTS_STORAGE_PATH=/app/storage/anexos

# ------------------------------------------------------------------------------
# 3. Frontend (React 19 / Vite / Nginx)
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173

# URL base da API injetada no build do Frontend (padrão "/api" usa o proxy reverso do Nginx)
VITE_API_URL=/api
VITE_USE_LOCAL_FALLBACK=false

# URL interna do Backend usada pelo proxy reverso do Nginx dentro da rede sigi-network
BACKEND_INTERNAL_URL=http://backend:8080
