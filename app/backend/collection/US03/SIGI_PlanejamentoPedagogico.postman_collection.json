    {
      "name": "2. PEI - Plano de Ensino Individualizado (TA3.1, TA3.2, TA3.4)",
      "description": "Fluxo completo do PEI cobrindo os testes de aceite da US 03.",
      "item": [
        {
          "name": "2.1 Criar PEI com Sucesso (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Deve retornar ID gerado e dados do plano preenchidos\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "    pm.expect(json.habilidadesInteresses).to.not.be.empty;",
                  "    pm.expect(json.propostasAdaptacoes).to.not.be.empty;",
                  "    pm.environment.set(\"peiId\", json.id);",
                  "});",
                  "",
                  "pm.test(\"TA3.1 - Dados institucionais carregados automaticamente do banco (alunoId e derivado do acompanhamento, o cliente nao envia)\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.alunoId).to.eql(pm.environment.get(\"alunoId\"));",
                  "    pm.expect(json.acompanhamentoId).to.eql(pm.environment.get(\"acompanhamentoId\"));",
                  "});",
                  "",
                  "pm.test(\"Auditoria: deve preencher criadoEm e atualizadoEm\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"criadoEm\");",
                  "    pm.expect(json).to.have.property(\"atualizadoEm\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{usuarioId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"acompanhamentoId\": \"{{acompanhamentoId}}\",\n  \"habilidadesInteresses\": \"Leitura compartilhada, comunicacao oral por imagens e interesse por atividades de natureza.\",\n  \"propostasAdaptacoes\": \"Material impresso em fonte ampliada, tempo adicional nas evaluacoes e apoio de tecnologia assistiva.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/peis",
              "host": ["{{baseUrl}}"],
              "path": ["api", "peis"]
            }
          }
        },
        {
          "name": "2.2 TA3.1 - Buscar PEI e confirmar dados institucionais automaticos (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"TA3.1 - Formulario carrega vinculo institucional sem reenvio pelo cliente\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.eql(pm.environment.get(\"peiId\"));",
                  "    pm.expect(json.alunoId).to.eql(pm.environment.get(\"alunoId\"));",
                  "    pm.expect(json.acompanhamentoId).to.eql(pm.environment.get(\"acompanhamentoId\"));",
                  "    pm.expect(json).to.have.property(\"criadoEm\");",
                  "});",
                  "",
                  "pm.test(\"TA3.1 - Observacao: matricula, turma e curso ainda nao sao expostos pela API (pendencia de modelagem)\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.not.have.property(\"matricula\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/peis/{{peiId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "peis", "{{peiId}}"]
            }
          }
        },
        {
          "name": "2.3 Falha: Criar PEI sem Habilidades e Interesses (400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 400 Bad Request\", function () {",
