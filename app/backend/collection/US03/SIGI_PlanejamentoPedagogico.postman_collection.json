                  "    pm.expect(json).to.have.property(\"status\", 400);",
                  "    pm.expect(json.detail).to.include(\"Os conhecimentos, habilidades e interesses são obrigatórios\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
