    {
      "name": "4. Criptografia AES-256 em Repouso e Acesso Estrito de Saúde (Task #51 - TA11.1, TA11.2, TA3.2)",
      "item": [
        {
          "name": "4.1 [TA11.1] Upload de Anexo Sensível (LAUDO_MEDICO) Cifrado em Repouso (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "",
                  "pm.test(\"TA11.1: Anexo médico deve ser marcado como criptografado e salvar ID\", function () {",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "    pm.expect(json.classificacao).to.eql(\"LAUDO_MEDICO\");",
                  "    pm.expect(json.criptografado).to.eql(true);",
                  "    pm.expect(json).to.not.have.property(\"iv\");",
                  "    pm.expect(json).to.not.have.property(\"caminhoArmazenamento\");",
                  "    pm.environment.set(\"anexoSensivelId\", json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "arquivo",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "classificacao",
                  "value": "LAUDO_MEDICO",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/estudantes/{{estudanteId}}/anexos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "estudantes", "{{estudanteId}}", "anexos"]
            }
          }
        },
        {
          "name": "4.2 Listar Metadados de Anexos do Estudante (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "pm.test(\"Deve retornar lista de metadados sem vazar IV ou caminho físico\", function () {",
                  "    pm.expect(json).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/estudantes/{{estudanteId}}/anexos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "estudantes", "{{estudanteId}}", "anexos"]
            }
          }
        },
        {
          "name": "4.3 [CA 2 - TA11.2] Download em Memória por Usuário Autorizado (SUPER_RESTRICAO + autorizacaoSaude=true) (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"CA 2 [TA11.2]: Status code deve ser 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Deve retornar headers Content-Disposition e Cache-Control no-store\", function () {",
                  "    pm.response.to.have.header(\"Content-Disposition\");",
                  "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/anexos/{{anexoSensivelId}}/download",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "anexos", "{{anexoSensivelId}}", "download"]
            }
          }
        },
