{
  "info": {
    "_postman_id": "f8a92e10-9b41-4c12-a123-5e7b89d11011",
    "name": "SIGI - US 11 Autenticação JWT, RBAC e Revogação de Sessão (Task #50)",
    "description": "Coleção de testes de integração para validação da US 11: Emissão de JWT com claims RBAC, inspeção de contexto de segurança, restrição de rotas administrativas e critério TA11.4 de Revogação Instantânea de Sessão.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autenticação e Claims JWT (CA 2)",
      "item": [
        {
          "name": "1.1 Login Aluno Apoiador (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "",
                  "pm.test(\"Deve retornar token JWT não vazio\", function () {",
                  "    pm.expect(json).to.have.property(\"token\");",
                  "    pm.expect(json.tipoToken).to.eql(\"Bearer\");",
                  "    pm.environment.set(\"tokenAluno\", json.token);",
                  "});",
                  "",
                  "pm.test(\"Deve conter claims esperadas de Aluno Apoiador\", function () {",
                  "    pm.expect(json.role).to.eql(\"ALUNO_APOIADOR\");",
                  "    pm.expect(json.nivelRestricao).to.eql(\"ACESSO_FUNCIONAL\");",
                  "    pm.expect(json.autorizacaoSaude).to.eql(false);",
                  "    pm.expect(json.tokenVersion).to.eql(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aluno.apoiador@sigi.ifpb.edu.br\",\n  \"senha\": \"senha123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "1.2 Obter Sessão Aluno Apoiador (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "",
                  "pm.test(\"SecurityContextHolder carregou authorities corretas\", function () {",
                  "    pm.expect(json.role).to.eql(\"ALUNO_APOIADOR\");",
                  "    pm.expect(json.acessoAtivo).to.eql(true);",
                  "    pm.expect(json.authorities).to.include(\"ROLE_ALUNO_APOIADOR\");",
                  "    pm.expect(json.authorities).to.include(\"REST_ACESSO_FUNCIONAL\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAluno}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        },
        {
          "name": "1.3 Login Administrador (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "",
                  "pm.test(\"Deve salvar token do Administrador\", function () {",
                  "    pm.expect(json).to.have.property(\"token\");",
                  "    pm.environment.set(\"tokenAdmin\", json.token);",
                  "});",
                  "",
                  "pm.test(\"Claims de Administrador devem ter autorizacaoSaude=true\", function () {",
                  "    pm.expect(json.role).to.eql(\"ADMIN\");",
                  "    pm.expect(json.nivelRestricao).to.eql(\"SUPER_RESTRICAO\");",
                  "    pm.expect(json.autorizacaoSaude).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sigi.ifpb.edu.br\",\n  \"senha\": \"senha123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "1.4 Obter Sessão Administrador (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "",
                  "pm.test(\"Authorities do Administrador incluem ROLE_ADMIN e AUTH_SAUDE\", function () {",
                  "    pm.expect(json.role).to.eql(\"ADMIN\");",
                  "    pm.expect(json.authorities).to.include(\"ROLE_ADMIN\");",
                  "    pm.expect(json.authorities).to.include(\"REST_SUPER_RESTRICAO\");",
                  "    pm.expect(json.authorities).to.include(\"AUTH_SAUDE\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Controle de Acesso RBAC",
      "item": [
        {
          "name": "2.1 Bloqueio: Aluno tenta revogar acesso (403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "pm.test(\"ProblemDetail deve indicar Acesso Negado\", function () {",
                  "    pm.expect(json.title).to.eql(\"Acesso Negado\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAluno}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/usuarios/{{alunoApoiadorId}}/revogar-acesso",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "usuarios", "{{alunoApoiadorId}}", "revogar-acesso"]
            }
          }
        },
        {
          "name": "2.2 Bloqueio: Requisição sem Token (401 Unauthorized)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Revogação Instantânea de Sessão (TA11.4)",
      "item": [
        {
          "name": "3.1 ADMIN executa Revogação do Aluno Apoiador (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code deve ser 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "pm.test(\"Acesso deve estar inativo e tokenVersion incrementada\", function () {",
                  "    pm.expect(json.acessoAtivo).to.eql(false);",
                  "    pm.expect(json.tokenVersion).to.be.above(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/usuarios/{{alunoApoiadorId}}/revogar-acesso",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "usuarios", "{{alunoApoiadorId}}", "revogar-acesso"]
            }
          }
        },
        {
          "name": "3.2 [TA11.4] Reuso do Token Anterior do Aluno Apoiador (401 Unauthorized)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"TA11.4: Token anterior deve ser sumariamente bloqueado (401 Unauthorized)\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "pm.test(\"ProblemDetail deve informar que a sessão ou acesso foi revogado\", function () {",
                  "    pm.expect(json.detail).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAluno}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        },
        {
          "name": "3.3 Tentativa de Novo Login com Usuário Revogado (401 Unauthorized)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Novo login de usuário revogado deve ser bloqueado (401 Unauthorized)\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aluno.apoiador@sigi.ifpb.edu.br\",\n  \"senha\": \"senha123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        }
      ]
    }
  ]
}
